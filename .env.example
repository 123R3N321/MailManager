# Copy this file to .env and fill in values from: cd infra/terraform && terraform output
# .env is gitignored — never commit it.

API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
REGION=us-east-1
ACCOUNT_ID=<your-aws-account-id>
TABLE=<terraform output dynamodb_table_name>
RAW_BUCKET=<terraform output raw_mail_bucket_name>
FRONTEND_BUCKET=<terraform output frontend_bucket_name>
QUEUE_URL=<terraform output sqs_ingest_queue_url>
DLQ_URL=<terraform output sqs_dlq_queue_url>
LAMBDA_API=<terraform output lambda_api_function_name>
LAMBDA_WORKER=<terraform output lambda_ingest_worker_function_name>
LAMBDA_SCHED=<terraform output lambda_schedule_stub_function_name>
OS_ENDPOINT=https://<terraform output opensearch_endpoint>
OS_INDEX=mailmanager-index
